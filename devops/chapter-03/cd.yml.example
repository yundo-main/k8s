name: CD

on:
  workflow_dispatch:
  push:
    tags:
      - 'v*'

env:
  IMAGE_NAMESPACE: jarrodkim
  IMAGE_TAG: ${{ github.sha }}

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      # 실제 애플리케이션 Dockerfile 경로에 맞춰 활성화한다.
      - name: Build and push backend image
        uses: docker/build-push-action@v6
        with:
          context: ./backend
          push: true
          tags: ${{ env.IMAGE_NAMESPACE }}/fastapi-backend:${{ env.IMAGE_TAG }}

      - name: Configure kubectl
        uses: azure/setup-kubectl@v4
      - name: Configure kubeconfig
        shell: bash
        run: |
          mkdir -p "${RUNNER_TEMP}/kube"
          echo "${{ secrets.KUBE_CONFIG }}" | base64 --decode > "${RUNNER_TEMP}/kube/config"
          echo "KUBECONFIG=${RUNNER_TEMP}/kube/config" >> "$GITHUB_ENV"

      - name: Validate deployment manifests
        run: |
          kubectl apply --dry-run=server -f k8s/practice-order/10-3tier/frontend.yml
          kubectl apply --dry-run=server -f k8s/practice-order/10-3tier/backend.yml
          kubectl apply --dry-run=server -f k8s/practice-order/11-ingress/ingress.yml

      - name: Apply Kubernetes manifests
        run: |
          kubectl apply -f k8s/practice-order/10-3tier/frontend.yml
          kubectl apply -f k8s/practice-order/10-3tier/backend.yml
          kubectl apply -f k8s/practice-order/11-ingress/ingress.yml
          kubectl rollout status deployment/frontend --timeout=180s
          kubectl rollout status deployment/fastcgi-backend --timeout=180s

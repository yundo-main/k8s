name: CI

on:
  pull_request:
  push:
    branches:
      - main

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.3'

      - name: Validate Kubernetes YAML
        run: |
          ruby -e 'require "yaml"; Dir["k8s/**/*.yml", "k8s/**/*.yaml"].each { |f| YAML.load_stream(File.read(f)); puts "YAML OK: #{f}" }'

      - name: Validate Kubernetes manifests
        run: |
          kubectl version --client
          kubectl apply --dry-run=client -f k8s/practice-order/10-3tier/frontend.yml
          kubectl apply --dry-run=client -f k8s/practice-order/10-3tier/backend.yml
          kubectl apply --dry-run=client -f k8s/practice-order/11-ingress/ingress.yml

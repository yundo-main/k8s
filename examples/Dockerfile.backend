FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# backend.yml의 ConfigMap에 저장된 main.py를 이미지 안으로 추출한다.
COPY backend.yml /tmp/backend.yml
RUN pip install --no-cache-dir --disable-pip-version-check \
      fastapi==0.115.6 \
      "uvicorn[standard]==0.34.0" \
      PyMySQL==1.1.1 \
      python-multipart==0.0.20 \
      PyYAML==6.0.2 \
    && python -c 'import yaml; docs=yaml.safe_load_all(open("/tmp/backend.yml", encoding="utf-8")); cm=next(doc for doc in docs if doc.get("kind") == "ConfigMap"); open("/app/main.py", "w", encoding="utf-8").write(cm["data"]["main.py"])'
RUN rm -f /tmp/backend.yml

# nginx와 같은 Pod 네트워크를 공유하므로 nginx의 80번 포트와 충돌하지 않게 한다.
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
